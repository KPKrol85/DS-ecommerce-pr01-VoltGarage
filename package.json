{
  "name": "volt-garage",
  "private": true,
  "description": "Static multi-page automotive accessories store demo by KP_Code Digital   Studio",
  "author": "Kamil Król — KP_Code Digital Studio",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KPKrol85/DS-ecommerce-pr01-VoltGarage.git"
  },
  "homepage": "https://e-commerce-pr01-voltgarage.netlify.app/",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "img:opt": "node tools/image-optimizer/optimize-images.mjs --only=jpg",
    "img:opt:png": "node tools/image-optimizer/optimize-images.mjs --only=png",
    "img:opt:all": "node tools/image-optimizer/optimize-images.mjs --only=all",
    "img:opt:out": "node tools/image-optimizer/optimize-images.mjs --mode=output --out=tools/image-optimizer/output --only=all",
    "img:opt:dry": "node tools/image-optimizer/optimize-images.mjs --dry-run --only=all",
    "build": "vite build",
    "preview": "vite preview",
    "qa": "npm run qa:html && npm run validate:jsonld && npm run qa:links && npm run qa:product-assets && npm run qa:js && npm run qa:css && npm run qa:build",
    "qa:format": "npm run format:check",
    "qa:html": "html-validate --config htmlvalidate.json \"*.html\" \"pages/**/*.html\"",
    "qa:js": "eslint --max-warnings 0 \"js/**/*.js\" \"src/sw.js\" \"scripts/**/*.{js,mjs}\" \"tools/**/*.mjs\" \"vite.config.mjs\"",
    "qa:css": "stylelint --max-warnings 0 \"css/**/*.css\"",
    "format": "prettier . --write",
    "format:html-tight": "prettier --write \"index.html\" \"404.html\" \"offline.html\" \"thank-you.html\" \"pages/**/*.html\" && node scripts/format-html-tight.js",
    "format:check": "prettier . --check",
    "validate:jsonld": "node scripts/validate-jsonld.js",
    "qa:links": "node scripts/validate-internal-links.js",
    "qa:product-assets": "node scripts/validate-product-assets.mjs",
    "qa:smoke": "node scripts/qa-smoke-lighthouse.js",
    "qa:smoke:enforce": "node scripts/qa-smoke-lighthouse.js --enforce",
    "dev": "vite",
    "qa:package": "node scripts/validate-package.mjs",
    "qa:build": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "chalk": "^5.3.0",
    "eslint": "^8.57.0",
    "fast-glob": "^3.3.2",
    "html-validate": "^10.4.0",
    "lighthouse": "^12.8.2",
    "minimist": "^1.2.8",
    "prettier": "^3.7.4",
    "sharp": "^0.33.2",
    "stylelint": "^16.13.0",
    "stylelint-config-recommended": "^14.0.0",
    "vite": "^8.2.2"
  }
}
